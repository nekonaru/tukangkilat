# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=tukangkilat
POSTGRES_USER=tukangkilat
POSTGRES_PASSWORD=tukangkilat

# Backend
DB_URL=jdbc:postgresql://localhost:5432/tukangkilat
DB_USER=tukangkilat
DB_PASSWORD=tukangkilat

# JWT: use a long random string in real deployments (e.g. openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ISSUER=tukangkilat

# Demo account passwords (seed only, read from env, never hardcoded)
DEMO_ADMIN_PASSWORD=admin12345
DEMO_CONSUMER_PASSWORD=rina12345
DEMO_TECH_PASSWORD=budi12345
DEMO_TECH2_PASSWORD=sari12345

# Upload directory (photos). Created automatically.
UPLOAD_DIR=uploads

# Base URL the Android app uses to reach the backend.
# Emulator uses 10.0.2.2 for the host machine.
APP_BASE_URL=http://10.0.2.2:8080
