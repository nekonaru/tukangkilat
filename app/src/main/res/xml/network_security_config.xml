<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Demo app: the backend runs on a local PC, so cleartext to a configurable address is allowed. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
